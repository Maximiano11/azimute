# Conexão com o Postgres do Docker (docker-compose.yml → host 5544)
DATABASE_URL=postgres://azimute:azimute@localhost:5544/azimute

# Segredo para assinar os tokens JWT — troque por um valor longo e aleatório em produção
JWT_SECRET=troque-este-segredo-em-producao-azimute

# Porta da API
PORT=4100

# Origem permitida no CORS (o dev server do Vite). Necessário com cookies de sessão.
CORS_ORIGIN=http://localhost:5181

# production ativa cookie "secure" (HTTPS) e exige JWT_SECRET forte
NODE_ENV=development

# Rate limiting (opcional) — tentativas por janela de 15 min
RATE_LIMIT_AUTH=50
RATE_LIMIT_API=600

# Força o cookie "secure" (HTTPS). Por padrão segue o NODE_ENV.
# Use "false" para demo em http; "true" em produção atrás de proxy TLS.
# COOKIE_SECURE=false
