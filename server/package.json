{
  "name": "azimute-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST do Azimute — auth, perfil, relatos, curtidas, comentários e alertas.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node-pg-migrate up -m migrations --envPath .env",
    "migrate:ci": "node-pg-migrate up -m migrations",
    "migrate:down": "node-pg-migrate down -m migrations --envPath .env",
    "migrate:create": "node-pg-migrate create -m migrations --",
    "seed": "node src/seed.js",
    "mock": "node src/mock.js",
    "setup": "npm run migrate && npm run seed",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.13.0",
    "serverless-http": "^4.0.0",
    "zod": "^4.4.3"
  }
}
